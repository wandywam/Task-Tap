{
  "manifest_version": 3,
  "name": "Task Tap",
  "version": "1.0.3",
  "description": "Quickly create Google Tasks and Calendar events from a popup.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "identity"],
  "oauth2": {
    "client_id": "837611272083-r0pearev5cdtmghdghkqnrchg80tghis.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks",
      "https://www.googleapis.com/auth/calendar"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}